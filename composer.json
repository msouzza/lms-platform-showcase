{
    "name": "contextopolicial/bm-exame-lms",
    "description": "Plataforma de Estudos (LMS) - Bombeiro Militar / Contexto Policial",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "php tests/ci/lint.php",
        "test": "phpunit --colors=always",
        "test:unit": "phpunit --testsuite Unit --colors=always",
        "test:regression": "phpunit --testsuite Regression --colors=always",
        "test:security": "phpunit --testsuite SecurityAudit --colors=always"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
